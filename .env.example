# docmatch — exemplo de configuração
#
# Copie para .env e preencha. O arquivo .env NUNCA é commitado.
# Em produção, o .env é gerado no boot a partir do SSM Parameter Store.
# Toda variável marcada como (obrigatória) faz o processo falhar no boot se faltar.
# Segredos não têm valor padrão.

# ---------------------------------------------------------------- Runtime
DM_ENV=dev                          # dev | staging | prod
DM_PUBLIC_BASE_URL=http://localhost:4321
DM_API_BASE_URL=http://localhost:8080
DM_API_LISTEN=127.0.0.1:8080
DM_ADMIN_LISTEN=127.0.0.1:8443      # painel admin: nunca exposto à internet
DM_ORIGIN_SECRET=change-me          # (obrigatória em prod) header secreto CloudFront -> origem
DM_ORIGIN_SECRET_HEADER=            # nome do header do segredo (prod: x-docmatch-origin-secret, vindo do Terraform); vazio = X-DM-Origin-Secret
DM_VANTARA_PATH=                    # (local apenas) pasta do caso privado; vazio usa o gêmeo sintético público
DM_KILL_FLAGS=                      # kill switches (camada 2): lista separada por vírgula que prevalece sobre o banco, ex.: spending,signups
DM_MAINTENANCE=0                    # 1 = modo manutenção: API responde 503 em tudo que não for saúde/versão

# -------------------------------------------------------- Banco e storage
DATABASE_URL=postgres://docmatch:docmatch@localhost:5432/docmatch?sslmode=disable
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=docmatch             # (dev) credenciais do S3 local (DM_DEV_S3_ACCESS_KEY do compose); vazias em prod (papel IAM da instância)
AWS_SECRET_ACCESS_KEY=docmatch-dev     # (dev) idem
DM_S3_UPLOADS_BUCKET=docmatch-uploads-dev
DM_S3_BACKUPS_BUCKET=docmatch-backups-dev
DM_S3_ENDPOINT=http://localhost:9000   # MinIO local; vazio em prod
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
DM_R2_MEDIA_BUCKET=docmatch-media-dev
DM_R2_ENDPOINT=                     # endpoint S3 do R2; vazio deriva de R2_ACCOUNT_ID (https://<conta>.r2.cloudflarestorage.com)
DM_MEDIA_LOCAL_DIR=.cache/media     # (dev) pasta local para mídia quando R2_* está vazio

# ------------------------------------------------------- Harness e scanner
DM_HARNESS_SOCKET=.cache/harness.sock   # (obrigatória em prod) socket Unix do gRPC do harness; vazio em dev = sem harness
DM_SCAN_QUEUE_URL=                  # (obrigatória em prod) fila SQS com os vereditos do scanner; vazio = scanner local
DM_SCANNER_BIN=dm-scanner           # (dev) binário do scanner procurado no PATH; ausente = só bytes mágicos

# ---------------------------------------------------------------- Modelos
DM_LLM_MODE=local                   # openrouter | local | off
OPENROUTER_API_KEY=                 # (obrigatória quando DM_LLM_MODE=openrouter)
DM_LOCAL_LLM_BASE_URL=http://localhost:11434/v1   # Ollama, llama.cpp ou vLLM (API compatível com OpenAI)
DM_MODELS_FILE=config/models.yaml
DM_LLM_CACHE_DIR=.cache/llm         # cache de respostas (modo replay nos testes)

# --------------------------------------------------------------- Autenticação
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=                  # conteúdo PEM, com \n escapado
GOOGLE_OAUTH_NATIVE_CLIENT_IDS=     # client ids do Google dos apps Android e iOS (audiências extras do login nativo), separados por vírgula
APPLE_NATIVE_CLIENT_IDS=            # bundle ids do app iOS (audiências do Sign in with Apple nativo), separados por vírgula
DM_SESSION_SECRET=                  # (obrigatória) 32+ bytes aleatórios, base64
DM_DEV_LOGIN=1                      # (dev apenas) entrar sem provedor nem e-mail (POST /v1/auth/dev/login); recusada fora de DM_ENV=dev

# --------------------------------------------------------------- Cobrança
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
DM_TARGET_MARGIN=0.30               # margem após modelos, infra, taxas e imposto
DM_INCOME_TAX_RATE=0.21             # imposto de renda federal (Delaware C corp)
DM_PAYMENT_RATE=0.076               # custo de pagamento, pior caso (cartão BR em conta US)
DM_INFRA_RATE=0.10                  # parcela de infraestrutura na receita
DM_OPENROUTER_FEE=0.055             # taxa da OpenRouter na compra de créditos
DM_PRICING_FILE=config/pricing.yaml
DM_THROUGHPUT_FILE=config/throughput.yaml   # tempo esperado dos orçamentos e e-mail de execução longa; vazia = throughput.yaml ao lado de DM_PRICING_FILE

# ------------------------------------------------------------------ E-mail
RESEND_API_KEY=
DM_EMAIL_FROM=docmatch <no-reply@example.com>
DM_SECURITY_CONTACT=security@example.com
DM_SMTP_ADDR=localhost:1025         # (dev apenas) SMTP sem autenticação do Mailpit de tools/dev; vazio em prod (usa RESEND_API_KEY)

# ---------------------------------------------------------- Chaves de assinatura
DM_QUOTE_HMAC_KEY=                  # (obrigatória) assina orçamentos
DM_APIKEY_PEPPER=                   # (obrigatória) HMAC das chaves de API
DM_WEBHOOK_SIGNING_KEY=             # (obrigatória) assina webhooks de saída

# ------------------------------------------- Trabalhadores sob demanda (docs/escala.md)
# Execuções pesadas vão para instâncias Spot que só existem enquanto há trabalho; o resto roda na
# máquina principal. Nada aqui recusa um pedido: sem pool, acima do teto ou sem capacidade, a
# execução roda na máquina principal, mais devagar, e o orçamento já mostra o tempo maior.
DM_BURST_ENABLED=0                  # 1 = manda as execuções pesadas para o pool; 0 = tudo na máquina principal
DM_BURST_LISTEN=                    # host:porta do endpoint interno (só VPC) que os trabalhadores chamam; vazio = desligado (prod: 0.0.0.0:8444)
DM_BURST_POOL_SECRET=               # 32+ caracteres compartilhados com os trabalhadores; vazio ou curto deixa o pool desligado (nunca derruba o boot)
DM_BURST_ASG_NAME=                  # grupo de Auto Scaling do pool (output do Terraform); vazio = trabalhadores à mão, sem AWS
DM_BURST_MIN_SECONDS=0              # tempo esperado na máquina principal a partir do qual a execução é pesada; 0 = large_after_seconds do throughput.yaml
DM_BURST_MEMORY_HEADROOM_MB=384     # memória que a máquina principal ainda dá a uma execução; estimativa acima disso vai para o pool
DM_BURST_KINDS=audio,video          # tipos de entrada que sempre vão para o pool (transcrição, OCR), separados por vírgula
DM_BURST_MAX_INSTANCES=2            # teto de instâncias simultâneas (o max_size do grupo também limita)
DM_BURST_MONTHLY_HOURS=60           # orçamento de horas de instância por mês (UTC); acima dele tudo roda na máquina principal
DM_BURST_IDLE_MINUTES=10            # minutos sem trabalho até o pool voltar a zero
DM_BURST_CLAIM_SECONDS=600          # espera máxima por um trabalhador antes de cair para a máquina principal
DM_BURST_API_URL=                   # (só no trabalhador) https://<ip privado da máquina principal>:8444, gravado no boot pela instância principal

# Prazo de uma execução: clamp(tempo esperado × fator, mínimo, máximo), igual nos dois caminhos.
DM_RUN_DEADLINE_MIN=2h
DM_RUN_DEADLINE_MAX=24h
DM_RUN_DEADLINE_FACTOR=3
