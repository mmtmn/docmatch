# docmatch — exemplo de configuração
#
# Copie para .env e preencha. O arquivo .env NUNCA é commitado.
# Em produção, o .env é gerado no boot a partir do SSM Parameter Store.
# Toda variável marcada como (obrigatória) faz o processo falhar no boot se faltar.
# Segredos não têm valor padrão.

# ---------------------------------------------------------------- Runtime
DM_ENV=dev                          # dev | staging | prod
DM_PUBLIC_BASE_URL=http://localhost:4321
DM_API_BASE_URL=http://localhost:8080
DM_API_LISTEN=127.0.0.1:8080
DM_ADMIN_LISTEN=127.0.0.1:8443      # painel admin: nunca exposto à internet
DM_ORIGIN_SECRET=change-me          # (obrigatória em prod) header secreto CloudFront -> origem
DM_VANTARA_PATH=                    # (local apenas) pasta do caso privado; vazio usa o gêmeo sintético público

# -------------------------------------------------------- Banco e storage
DATABASE_URL=postgres://docmatch:docmatch@localhost:5432/docmatch?sslmode=disable
AWS_REGION=us-east-1
DM_S3_UPLOADS_BUCKET=docmatch-uploads-dev
DM_S3_BACKUPS_BUCKET=docmatch-backups-dev
DM_S3_ENDPOINT=http://localhost:9000   # MinIO local; vazio em prod
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
DM_R2_MEDIA_BUCKET=docmatch-media-dev

# ---------------------------------------------------------------- Modelos
DM_LLM_MODE=local                   # openrouter | local | off
OPENROUTER_API_KEY=                 # (obrigatória quando DM_LLM_MODE=openrouter)
DM_LOCAL_LLM_BASE_URL=http://localhost:11434/v1   # Ollama, llama.cpp ou vLLM (API compatível com OpenAI)
DM_MODELS_FILE=config/models.yaml
DM_LLM_CACHE_DIR=.cache/llm         # cache de respostas (modo replay nos testes)

# --------------------------------------------------------------- Autenticação
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=                  # conteúdo PEM, com \n escapado
DM_SESSION_SECRET=                  # (obrigatória) 32+ bytes aleatórios, base64

# --------------------------------------------------------------- Cobrança
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
DM_TARGET_MARGIN=0.30               # margem após modelos, infra, taxas e imposto
DM_INCOME_TAX_RATE=0.21             # imposto de renda federal (Delaware C corp)
DM_PAYMENT_RATE=0.076               # custo de pagamento, pior caso (cartão BR em conta US)
DM_INFRA_RATE=0.10                  # parcela de infraestrutura na receita
DM_OPENROUTER_FEE=0.055             # taxa da OpenRouter na compra de créditos
DM_PRICING_FILE=config/pricing.yaml

# ------------------------------------------------------------------ E-mail
RESEND_API_KEY=
DM_EMAIL_FROM=docmatch <no-reply@example.com>
DM_SECURITY_CONTACT=security@example.com

# ---------------------------------------------------------- Chaves de assinatura
DM_QUOTE_HMAC_KEY=                  # (obrigatória) assina orçamentos
DM_APIKEY_PEPPER=                   # (obrigatória) HMAC das chaves de API
DM_WEBHOOK_SIGNING_KEY=             # (obrigatória) assina webhooks de saída
