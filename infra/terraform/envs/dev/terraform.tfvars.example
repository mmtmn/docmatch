# Copie para terraform.tfvars (nunca commitado) e preencha. O ambiente dev tem a própria zona
# (dev.<domínio>), delegada por um registro NS em extra_dns_records do ambiente prod.

account_id             = "123456789012"
region                 = "us-east-1"
domain                 = "dev.docmatch.com.br"
mrr_usd                = 0
alert_email            = "alertas@example.com"
email_from             = "docmatch dev <no-reply@example.com>"
security_contact_email = "security@example.com"
dmarc_rua_email        = ""

# Id da conta Cloudflare (32 hexadecimais). Vazio pula o módulo r2 até o token existir.
cloudflare_account_id = ""

# Preenchidos depois: AMI do packer build e tag das imagens do sandbox no ECR.
ami_id           = ""
lambda_image_tag = ""

# No primeiro apply, antes de delegar dev.<domínio> na zona prod, use false: a distribuição nasce
# com o certificado padrão *.cloudfront.net e sem os aliases. Depois da delegação volte para true.
wait_for_certificate_validation = false
dnssec_enabled                  = false

worker_desired_capacity = 0

# Pool of on-demand Spot workers (docs/escala.md). Turn on after the AMI with docmatch-burst.service
# is in ami_id and DM_BURST_POOL_SECRET holds 32+ random characters in SSM.
burst_enabled       = false
burst_max_instances = 2
burst_monthly_hours = 60
burst_budget_usd    = 5
enable_flow_logs        = false
llm_mode                = "off"
