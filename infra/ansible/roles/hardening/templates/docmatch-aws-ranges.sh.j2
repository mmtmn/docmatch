#!/usr/bin/env bash
# {{ ansible_managed }}
# Writes /etc/nftables.d/10-aws-ranges.nft with the published AWS ranges (direct egress for the
# allowed users) and the CloudFront origin-facing ranges (inbound 443), then reloads nftables.
# The image build runs it once with --no-reload so the first boot already has the sets.
set -euo pipefail
url="{{ hardening_aws_ip_ranges_url }}"
out="/etc/nftables.d/10-aws-ranges.nft"
services='{{ hardening_aws_ip_ranges_services | join(" ") }}'
reload=1
[[ "${1:-}" == "--no-reload" ]] && reload=0

tmp_json="$(mktemp)"
tmp_nft="$(mktemp)"
trap 'rm -f "$tmp_json" "$tmp_nft"' EXIT

# ip-ranges.amazonaws.com is served by CloudFront; the sets from the image let the first fetch
# through, later fetches refresh them.
curl -fsSL --max-time 60 --retry 3 -o "$tmp_json" "$url"
jq -e '.prefixes | length > 1000' "$tmp_json" >/dev/null

svc_filter="$(printf '%s\n' "$services" | tr ' ' '\n' | jq -R . | jq -sc .)"
{
  echo "# Generated by docmatch-aws-ranges from ip-ranges.json syncToken $(jq -r .syncToken "$tmp_json") at $(date -u +%FT%TZ)"
  echo "table inet docmatch {"
  echo "  set aws_v4 { type ipv4_addr; flags interval; auto-merge; elements = {"
  jq -r --argjson s "$svc_filter" '[.prefixes[] | select(.service as $x | $s | index($x)) | .ip_prefix] | unique | join(",\n")' "$tmp_json"
  echo "  } }"
  echo "  set aws_v6 { type ipv6_addr; flags interval; auto-merge; elements = {"
  jq -r --argjson s "$svc_filter" '[.ipv6_prefixes[] | select(.service as $x | $s | index($x)) | .ipv6_prefix] | unique | join(",\n")' "$tmp_json"
  echo "  } }"
  echo "  set cloudfront_v4 { type ipv4_addr; flags interval; auto-merge; elements = {"
  jq -r '[.prefixes[] | select(.service == "CLOUDFRONT_ORIGIN_FACING") | .ip_prefix] | unique | join(",\n")' "$tmp_json"
  echo "  } }"
  echo "}"
} > "$tmp_nft"

nft -c -f "$tmp_nft"
install -m 0640 -o root -g root "$tmp_nft" "$out"
if [[ $reload -eq 1 ]] && systemctl is-active --quiet nftables; then
  nft -f /etc/nftables.conf
fi
echo "docmatch-aws-ranges: $(grep -c '/' "$out") prefixos gravados em $out"
