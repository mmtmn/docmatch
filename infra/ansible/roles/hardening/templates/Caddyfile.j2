# {{ ansible_managed }}
# Origin server behind CloudFront. Variables come from {{ hardening_caddy_env_file }} (rendered
# from SSM at boot) and /etc/caddy/crowdsec.env. Port 80 is never opened: CloudFront redirects.
{
	admin unix//run/caddy/admin.sock
	auto_https disable_redirects
	email {$DM_ALERT_EMAIL}
	servers {
		# Only CloudFront reaches 443 (security group + nftables) and every request must carry the
		# origin secret, so the forwarded client address can be trusted from any peer.
		trusted_proxies static 0.0.0.0/0 ::/0
		client_ip_headers X-Forwarded-For
		timeouts {
			read_body {{ hardening_caddy_read_timeout }}
			read_header {{ hardening_caddy_header_timeout }}
			write {{ hardening_caddy_write_timeout }}
			idle {{ hardening_caddy_idle_timeout }}
		}
		max_header_size {{ hardening_caddy_max_header_bytes }}
		protocols h1 h2
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
		level WARN
	}
	crowdsec {
		api_url http://127.0.0.1:8181/
		api_key {$CROWDSEC_BOUNCER_KEY}
		ticker_interval 10s
		disable_streaming
	}
}

origin.{$DM_DOMAIN}:{{ hardening_https_port }} {
	tls {
		dns route53 {
			region {$AWS_REGION}
			hosted_zone_id {$DM_ROUTE53_ZONE_ID}
			wait_for_propagation true
			max_wait_dur 2m
		}
		protocols tls1.2 tls1.3
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 7
			roll_keep_for 168h
		}
		format json
	}

	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		defer
	}

	# 1. Anything without the origin secret did not come through our distribution.
	@unauthenticated not header {$DM_ORIGIN_SECRET_HEADER} {$DM_ORIGIN_SECRET}
	respond @unauthenticated 403

	# 2. Methods that never reach the application.
	@trace method TRACE TRACK CONNECT
	respond @trace 405

	# 3. Scanner paths: empty 404 before any handler.
	@probes {
		path /.env* /.git* /.svn* /.hg* /.aws* /.ssh* /.docker* /.vscode* /.idea* /.DS_Store
		path /wp-admin* /wp-login.php /wp-content* /wp-includes* /wp-json* /xmlrpc.php /wordpress*
		path /cgi-bin/* /phpmyadmin* /pma* /myadmin* /mysql* /adminer* /phpinfo* /info.php
		path /server-status /server-info /actuator* /console* /jmx-console* /manager/html*
		path /vendor/phpunit* /telescope* /_profiler* /elmah.axd /trace.axd /owa/* /ecp/* /autodiscover*
		path /remote/login* /boaform* /HNAP1* /shell* /solr* /jenkins* /geoserver* /struts* /hudson*
		path /config.json /config.php /configuration.php /backup* /dump.sql /db.sql
		path *.php *.php7 *.phtml *.asp *.aspx *.jsp *.jspx *.cgi *.sql *.bak *.old *.orig *.swp *.ini
	}
	respond @probes 404

	# 4. Addresses banned by fail2ban (regenerated by docmatch-caddy-denylist).
	import /etc/caddy/snippets/denylist.caddy

	# 5. CrowdSec decisions on the real client address.
	crowdsec

	request_body {
		max_size {{ hardening_caddy_max_body }}
	}

	encode zstd gzip

	reverse_proxy {{ hardening_api_listen }} {
		header_up X-Real-IP {client_ip}
		header_up -{$DM_ORIGIN_SECRET_HEADER}
		transport http {
			dial_timeout 5s
			read_timeout {{ hardening_caddy_write_timeout }}
		}
		flush_interval -1
	}

	handle_errors {
		respond "" {err.status_code}
	}
}
