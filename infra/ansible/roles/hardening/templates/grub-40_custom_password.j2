#!/bin/sh
# {{ ansible_managed }}
# GRUB superuser hook. EC2 exposes no interactive boot console, so this only matters if the image
# is ever used where one exists. To enable: generate a hash with `grub-mkpasswd-pbkdf2`, pass it
# as hardening_grub_password_hash (never commit it) and rebuild the image. With an empty hash the
# hook prints nothing and the boot menu stays unlocked (Lynis BOOT-5122 reports it).
exec tail -n +9 "$0"
{% if hardening_grub_password_hash | default('') != '' %}
set superusers="root"
password_pbkdf2 root {{ hardening_grub_password_hash }}
{% endif %}
