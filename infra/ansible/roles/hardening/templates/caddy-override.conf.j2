# {{ ansible_managed }}
[Unit]
# ACME goes through the egress proxy: started before it, the first order failed with
# "connection refused" and Caddy moved its retries to the staging CA.
After=docmatch-env.service tinyproxy.service
Wants=docmatch-env.service tinyproxy.service

[Service]
EnvironmentFile={{ hardening_caddy_env_file }}
EnvironmentFile=-/etc/caddy/crowdsec.env
# The packaged unit runs `caddy run --environ`, which prints the whole environment (origin secret,
# CrowdSec key) to the journal at every start.
ExecStart=
ExecStart=/usr/bin/caddy run --config /etc/caddy/Caddyfile
ExecReload=
ExecReload=/usr/bin/caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile --address unix//run/caddy/admin.sock --force
RuntimeDirectory=caddy
RuntimeDirectoryMode=0750
MemoryMax={{ hardening_mem_caddy }}
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
ReadWritePaths=/var/lib/caddy /var/log/caddy
