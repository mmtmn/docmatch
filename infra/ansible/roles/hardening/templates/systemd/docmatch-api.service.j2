# {{ ansible_managed }}
[Unit]
Description=docmatch API (Go)
After=docmatch-env.service postgresql@{{ hardening_pg_version }}-{{ hardening_pg_cluster }}.service docmatch-harness.service
Requires=docmatch-env.service
Wants=docmatch-harness.service
ConditionPathExists={{ hardening_app_bin_dir }}/docmatch-api

[Service]
Type=simple
Slice=docmatch-go.slice
User={{ hardening_app_user }}
Group={{ hardening_app_group }}
EnvironmentFile={{ hardening_env_file }}
Environment=DM_API_LISTEN={{ hardening_api_listen }} DM_ADMIN_LISTEN={{ hardening_admin_listen }} DM_HARNESS_SOCKET={{ hardening_harness_socket }}
Environment=DM_LLM_CACHE_DIR={{ hardening_app_home }}/cache/llm GOMEMLIMIT=120MiB
Environment=DM_MEDIA_LOCAL_DIR={{ hardening_media_dir }} DM_PRICING_FILE={{ hardening_app_config_dir }}/pricing.yaml DM_MODELS_FILE={{ hardening_app_config_dir }}/models.yaml
WorkingDirectory={{ hardening_app_home }}
ExecStart={{ hardening_app_bin_dir }}/docmatch-api
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=16384

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
UMask=0077
ReadWritePaths={{ hardening_app_home }} /var/log/docmatch
ReadOnlyPaths={{ hardening_env_file }}

[Install]
WantedBy=multi-user.target
