# {{ ansible_managed }}
# Burst worker of the pool of on-demand workers (docs/escala.md): claims signed job manifests from
# the application's internal endpoint, runs the local harness and streams the events back. It
# reads DM_BURST_API_URL, DM_BURST_POOL_SECRET, DM_HARNESS_SOCKET and DM_MEDIA_LOCAL_DIR only: the
# burst role's SSM list (DM_SSM_NAMES) carries no database or store credential. Enabled by
# user-data on the worker role, never on the application instance.
[Unit]
Description=docmatch burst worker (Go): pool job claims, local harness, events to the API
After=docmatch-env.service docmatch-harness.service
Requires=docmatch-env.service
Wants=docmatch-harness.service
ConditionPathExists={{ hardening_app_bin_dir }}/docmatch-worker

[Service]
Type=simple
Slice=docmatch-go.slice
User={{ hardening_app_user }}
Group={{ hardening_app_group }}
EnvironmentFile={{ hardening_env_file }}
EnvironmentFile={{ hardening_instance_env_file }}
Environment=DM_HARNESS_SOCKET={{ hardening_harness_socket }} DM_MEDIA_LOCAL_DIR={{ hardening_media_dir }} GOMEMLIMIT=120MiB
# Re-render the environment on every start (as root, failure tolerated): after a replacement of
# the application instance the restart picks up its new DM_BURST_API_URL.
ExecStartPre=-+/usr/local/sbin/docmatch-render-env --out {{ hardening_env_file }} --owner {{ hardening_app_user }}
ExecStart={{ hardening_app_bin_dir }}/docmatch-worker burst
Restart=always
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
LimitNOFILE=16384

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
UMask=0077
ReadWritePaths={{ hardening_app_home }} /var/log/docmatch
ReadOnlyPaths={{ hardening_env_file }}

[Install]
WantedBy=multi-user.target
