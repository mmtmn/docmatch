# {{ ansible_managed }}
# docmatch overrides for PostgreSQL {{ hardening_pg_version }} on a 2 GiB instance (512 MiB budget).
listen_addresses = 'localhost'
port = {{ hardening_pg_port }}
max_connections = {{ hardening_pg_max_connections }}
superuser_reserved_connections = 3

# Transport and authentication
ssl = on
ssl_cert_file = '/etc/postgresql/{{ hardening_pg_version }}/{{ hardening_pg_cluster }}/server.crt'
ssl_key_file = '/etc/postgresql/{{ hardening_pg_version }}/{{ hardening_pg_cluster }}/server.key'
ssl_min_protocol_version = 'TLSv1.3'
ssl_prefer_server_ciphers = on
password_encryption = scram-sha-256
scram_iterations = 4096
authentication_timeout = 20s

# Memory
shared_buffers = {{ hardening_pg_shared_buffers }}
effective_cache_size = {{ hardening_pg_effective_cache_size }}
work_mem = {{ hardening_pg_work_mem }}
maintenance_work_mem = {{ hardening_pg_maintenance_work_mem }}
temp_buffers = 8MB
huge_pages = off
max_worker_processes = 4
max_parallel_workers = 2
max_parallel_workers_per_gather = 1

# WAL and checkpoints (gp3 volume, pgBackRest archiving)
wal_level = replica
wal_compression = zstd
max_wal_size = 512MB
min_wal_size = 128MB
checkpoint_completion_target = 0.9
archive_mode = on
archive_command = '/usr/local/bin/docmatch-pgbackrest --stanza=docmatch archive-push %p'
archive_timeout = 300

# Query safety
statement_timeout = 60s
idle_in_transaction_session_timeout = 60s
lock_timeout = 10s
default_transaction_isolation = 'read committed'
row_security = on

# Logging (to the collector, rotated daily, read by Falco/journald via the file)
log_destination = 'stderr'
logging_collector = on
log_directory = '/var/log/postgresql'
log_filename = 'postgresql-%a.log'
log_rotation_age = 1d
log_rotation_size = 0
log_truncate_on_rotation = on
log_min_messages = warning
log_min_error_statement = error
log_min_duration_statement = 500
log_checkpoints = on
log_connections = on
log_disconnections = on
log_lock_waits = on
log_temp_files = 0
log_autovacuum_min_duration = 1s
log_error_verbosity = default
log_line_prefix = '%m [%p] %q%u@%d %a '
log_timezone = 'UTC'

# Extensions the application is allowed to load (nothing else is preloaded)
shared_preload_libraries = 'pg_stat_statements'
pg_stat_statements.track = top
