# {{ ansible_managed }}
# docmatch rules: what matters on this box and what is expected noise.
- list: docmatch_binaries
  items: [docmatch-api, docmatch-worker, docmatch-harness]

- list: docmatch_sensitive_files
  items: [{{ hardening_env_file }}, {{ hardening_caddy_env_file }}, /run/docmatch/env.postgres, /etc/caddy/crowdsec.env]

- rule: docmatch secrets read by an unexpected process
  desc: The rendered environment is read by anything other than the application, Caddy, PostgreSQL or the renderer.
  condition: >
    open_read and fd.name in (docmatch_sensitive_files)
    and not proc.name in (docmatch_binaries)
    and not proc.name in (caddy, pgbackrest, docmatch-pgbackrest, postgres, bash, docmatch-render-, docmatch-egress-, docmatch-pg-init, sed, grep, jq, systemd)
  output: >
    Rendered secrets read by an unexpected process (user=%user.name proc=%proc.name parent=%proc.pname file=%fd.name cmdline=%proc.cmdline)
  priority: CRITICAL
  tags: [docmatch, secrets]

- rule: Shell spawned by a docmatch service
  desc: The application never spawns an interactive shell; a shell under its process tree means code execution.
  condition: >
    spawned_process and proc.name in (bash, sh, dash, zsh)
    and proc.pname in (docmatch_binaries)
  output: >
    Shell spawned by a docmatch service (user=%user.name parent=%proc.pname cmdline=%proc.cmdline)
  priority: CRITICAL
  tags: [docmatch, execution]

- rule: Outbound connection by a docmatch service bypassing the proxy
  desc: Application processes talk to AWS endpoints directly and to everything else through the proxy; any other destination port is suspicious.
  condition: >
    outbound and proc.name in (docmatch_binaries)
    and not fd.sport in (8080, 8443)
    and not (fd.rip = "127.0.0.1" and fd.rport in (8118, 5432))
    and not fd.rport in (443)
  output: >
    Unexpected outbound connection from a docmatch service (proc=%proc.name connection=%fd.name)
  priority: WARNING
  tags: [docmatch, network]

# Expected activity on this image, excluded from the upstream rules.
- rule: Read sensitive file untrusted
  append: true
  condition: and not proc.name in (docmatch-render-, lynis, rkhunter, aide, debsums, sudo, unix_chkpwd, ssm-agent-worke, ssm-session-wor)

- rule: Write below etc
  append: true
  condition: and not proc.name in (docmatch-egress-, docmatch-caddy-, docmatch-aws-ran, fail2ban-server, unattended-upgr, dpkg, apt-get, certbot, caddy, freshclam)

- rule: Run shell untrusted
  append: true
  condition: and not proc.pname in (systemd, cron, ssm-session-wor, sudo)
