# {{ ansible_managed }}
# Kernel command line hardening. audit=1 starts auditing before auditd; the rest reduces the
# attack surface of the kernel allocator and removes legacy entry points.
GRUB_CMDLINE_LINUX="$GRUB_CMDLINE_LINUX audit=1 audit_backlog_limit=8192 slab_nomerge init_on_alloc=1 init_on_free=1 page_alloc.shuffle=1 randomize_kstack_offset=on debugfs=off module.sig_enforce=1"
GRUB_TIMEOUT=0
GRUB_RECORDFAIL_TIMEOUT=0
