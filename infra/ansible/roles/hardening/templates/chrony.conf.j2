# {{ ansible_managed }}
# Amazon Time Sync Service (link-local, reachable without any firewall rule or internet access).
server {{ hardening_aws_link_local_ntp }} prefer iburst minpoll 4 maxpoll 4
server {{ hardening_aws_link_local_ntp_v6 }} iburst minpoll 4 maxpoll 4

driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony
maxupdateskew 100.0
rtcsync
makestep 1 3
leapsectz right/UTC
# Never serve time to anyone and never answer commands from the network.
port 0
cmdport 0
