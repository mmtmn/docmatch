#!/usr/sbin/nft -f
# {{ ansible_managed }}
# Default-deny firewall of the docmatch instance.
#   inbound : 443 from CloudFront's origin-facing ranges (the security group enforces the same)
#   outbound: VPC link-local services, AWS endpoints for the listed users, the egress proxy for
#             everything else. No DNS, NTP or HTTP leaves otherwise.
#   internal: the chains internal_in / internal_out are empty in the image; the user-data of each
#             role fills them at boot in {{ hardening_nft_runtime_dir }} (tmpfs, never in /etc):
#             the application admits the burst workers' subnet on the internal endpoint port, a
#             burst worker may reach that port (docs/escala.md). The security groups do the same.
# Only the docmatch table is replaced on reload: the CrowdSec bouncer keeps its own tables.
table inet docmatch {}
delete table inet docmatch

include "/etc/nftables.d/*.nft"
# Role rules written by user-data at boot; a missing directory matches nothing.
include "{{ hardening_nft_runtime_dir }}/*.nft"

table inet docmatch {
	set aws_v4 { type ipv4_addr; flags interval; auto-merge; }
	set aws_v6 { type ipv6_addr; flags interval; auto-merge; }
	set cloudfront_v4 { type ipv4_addr; flags interval; auto-merge; }

	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" accept
		ct state established,related accept
		ct state invalid drop
		ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem, echo-request } limit rate 10/second accept
		ip6 nexthdr icmpv6 icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, nd-redirect, packet-too-big, time-exceeded, parameter-problem, destination-unreachable, echo-request } accept
		udp sport 67 udp dport 68 accept
		udp sport 547 udp dport 546 accept
		tcp dport {{ hardening_https_port }} ip saddr @cloudfront_v4 accept
		jump internal_in
		jump breakglass
		limit rate 5/minute log prefix "nft-in-drop " level warn
	}

	chain breakglass {
		# Filled by /etc/nftables.d/20-breakglass.nft when the break-glass path is enabled.
	}

	chain internal_in {
		# Filled at boot by user-data (application role): the internal endpoint for the pool.
	}

	chain internal_out {
		# Filled at boot by user-data (burst worker role): the application's internal endpoint.
	}

	chain output {
		type filter hook output priority filter; policy drop;
		oif "lo" accept
		ct state established,related accept
		ct state invalid drop
		ip protocol icmp accept
		ip6 nexthdr icmpv6 accept
		udp dport 67 accept
		udp dport 547 accept
		# VPC resolver (systemd-resolved only), Amazon Time Sync, instance metadata
		meta skuid "systemd-resolve" udp dport 53 accept
		meta skuid "systemd-resolve" tcp dport 53 accept
		ip daddr {{ hardening_aws_link_local_dns }} udp dport 53 accept
		ip daddr {{ hardening_aws_link_local_ntp }} udp dport 123 meta skuid "_chrony" accept
		ip6 daddr {{ hardening_aws_link_local_ntp_v6 }} udp dport 123 meta skuid "_chrony" accept
		ip daddr {{ hardening_aws_link_local_imds }} tcp dport 80 meta skuid { {{ hardening_imds_users | map('regex_replace', '^(.*)$', '"\\1"') | join(', ') }} } accept
		# AWS endpoints (S3 through the gateway endpoint, SSM, EC2, SQS, Lambda, Route 53)
		ip daddr @aws_v4 tcp dport 443 meta skuid { {{ hardening_egress_direct_users | map('regex_replace', '^(.*)$', '"\\1"') | join(', ') }} } accept
		ip6 daddr @aws_v6 tcp dport 443 meta skuid { {{ hardening_egress_direct_users | map('regex_replace', '^(.*)$', '"\\1"') | join(', ') }} } accept
		jump internal_out
		# Everything else goes through the egress proxy (allowlisted hosts only)
		tcp dport { 80, 443 } meta skuid "{{ hardening_proxy_user }}" accept
		limit rate 5/minute log prefix "nft-out-drop " level warn
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}
}
