{
  "name": "@docmatch/web",
  "version": "0.1.0",
  "private": true,
  "description": "Site, blog e app web da docmatch (Astro + React), inteiramente em pt-BR.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node tools/i18n-check.mjs && astro build",
    "preview": "node tools/serve-dist.mjs",
    "check": "astro check",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check . && node tools/i18n-check.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lhci": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@docmatch/locales": "workspace:*",
    "astro": "7.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
