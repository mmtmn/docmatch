---
import { PUBLIC_DM_SOURCE_URL, PUBLIC_DM_STATUS_URL } from 'astro:env/server';
import { t } from '../../lib/i18n';

const year = new Date().getUTCFullYear();
const links = [
  { href: '/termos', label: t('footer.terms') },
  { href: '/privacidade', label: t('footer.privacy') },
  { href: '/.well-known/security.txt', label: t('footer.security') },
  { href: '/contato', label: t('footer.contact') },
  ...(PUBLIC_DM_SOURCE_URL ? [{ href: PUBLIC_DM_SOURCE_URL, label: t('footer.source') }] : []),
  ...(PUBLIC_DM_STATUS_URL ? [{ href: PUBLIC_DM_STATUS_URL, label: t('footer.status') }] : []),
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <p class="footer__brand">{t('meta.site_name')}</p>
      <p class="footer__tagline">{t('footer.tagline')}</p>
    </div>
    <nav aria-label={t('nav.footer_navigation')}>
      <ul class="footer__list">
        {links.map((link) => (
          <li>
            <a class="footer__link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="footer__legal">
      {t('footer.copyright', { year: String(year) })}
      {t('footer.made_in')}
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: var(--fs-sm);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }

  .footer__brand {
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .footer__tagline {
    color: var(--color-muted);
  }

  .footer__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--color-fg);
  }

  .footer__legal {
    color: var(--color-muted);
  }
</style>
