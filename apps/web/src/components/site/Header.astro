---
import { t } from '../../lib/i18n';
import { canonicalPath } from '../../lib/canonical';
import { SessionNav } from './SessionNav';
import { AccountSwitcher } from './AccountSwitcher';

interface Props {
  variant?: 'site' | 'app';
}

const { variant = 'site' } = Astro.props;

const links = [
  { href: '/#como-funciona', label: t('nav.how_it_works') },
  { href: '/#planos', label: t('nav.plans') },
  { href: '/#seguranca', label: t('nav.security') },
  { href: '/blog', label: t('nav.blog') },
  { href: '/docs', label: t('nav.docs') },
  { href: '/contato', label: t('nav.contact') },
];
---

<header class="header" data-variant={variant}>
  <div class="header__inner container">
    <a class="header__logo" href="/" aria-label={t('nav.logo_label')}>
      {t('meta.site_name')}
    </a>
    {variant === 'app' && (
      <div class="header__account">
        <AccountSwitcher client:load />
      </div>
    )}
    {variant === 'site' && (
      <nav class="header__nav" aria-label={t('nav.main_navigation')}>
        <ul class="header__list">
          {links.map((link) => (
            <li>
              <a class="header__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <details class="header__menu">
          <summary class="header__summary">{t('nav.menu_open')}</summary>
          <ul class="header__sheet">
            {links.map((link) => (
              <li>
                <a class="header__sheetLink" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    )}
    <SessionNav path={canonicalPath(Astro.url.pathname)} client:load />
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    min-height: 3.25rem;
  }

  .header__logo {
    font-weight: 800;
    font-size: var(--fs-lg);
    letter-spacing: -0.02em;
    color: var(--color-fg);
    text-decoration: none;
    margin-right: auto;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .header__nav {
    display: flex;
    align-items: center;
  }

  .header[data-variant='app'] .header__logo {
    margin-right: 0;
  }

  .header__account {
    flex: 1;
    min-width: min(7rem, 100%);
  }

  .header__list {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-2);
    color: var(--color-fg);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 500;
    border-radius: var(--radius-1);
  }

  .header__link:hover {
    color: var(--color-accent);
    background: var(--color-surface);
  }

  .header__menu {
    position: relative;
    display: none;
  }

  .header__summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-2);
    border-radius: var(--radius-1);
    font-size: var(--fs-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .header__summary::-webkit-details-marker {
    display: none;
  }

  .header__sheet {
    position: absolute;
    right: 0;
    top: calc(100% + 4px);
    z-index: 50;
    min-width: 12rem;
    margin: 0;
    padding: var(--space-1);
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2);
    background: var(--color-bg);
    box-shadow: var(--shadow-2);
  }

  .header__sheetLink {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-3);
    color: var(--color-fg);
    text-decoration: none;
    border-radius: var(--radius-1);
  }

  .header__sheetLink:hover {
    background: var(--color-surface);
  }

  @media (max-width: 48em) {
    .header__list {
      display: none;
    }

    .header__menu {
      display: block;
    }
  }
</style>
