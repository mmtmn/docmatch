---
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/format';
import { t } from '../../lib/i18n';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<section class="section" id="blog" aria-labelledby="blog-titulo">
  <div class="container">
    <h2 class="section__heading" id="blog-titulo">
      {t('blog.heading')}
    </h2>
    <p class="section__lead">{t('blog.lead')}</p>
    {posts.length === 0 ? (
      <p class="muted">{t('blog.empty')}</p>
    ) : (
      <ul class="grid-3 posts">
        {posts.map((post) => (
          <li class="card post">
            <p class="small muted">
              <time datetime={post.data.pubDate.toISOString()}>
                {t('blog.published_on', { date: formatDate(post.data.pubDate) })}
              </time>
            </p>
            <h3>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>
            <p class="muted">{post.data.description}</p>
          </li>
        ))}
      </ul>
    )}
    <p class="link-row">
      <a href="/blog">{t('blog.all_posts')}</a>
    </p>
  </div>
</section>

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .link-row {
    margin-top: var(--space-4);
  }
</style>
