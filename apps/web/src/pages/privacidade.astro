---
import LegalSections from '../components/site/LegalSections.astro';
import Base from '../layouts/Base.astro';
import { formatShortDate } from '../lib/format';
import { t, tf } from '../lib/i18n';

// Updated whenever the text in packages/locales changes.
const UPDATED_AT = '2026-11-04';
---

<Base title={t('legal.privacy.title')} description={t('legal.privacy.description')}>
  <LegalSections
    title={t('legal.privacy.title')}
    updated={formatShortDate(UPDATED_AT)}
    sections={tf('legal.privacy.sections')}
  />
</Base>
