---
// Target of the link in the sign-in e-mail (?challenge_id=<id>&code=<token>).
import { MagicLink } from '../../components/account/MagicLink';
import Header from '../../components/site/Header.astro';
import Base from '../../layouts/Base.astro';
import { t } from '../../lib/i18n';
---

<Base title={t('auth.login_title')} hideHeader noindex>
  <Header variant="app" />
  <main id="conteudo" class="container login">
    <MagicLink client:only="react" />
  </main>
</Base>

<style>
  .login {
    max-width: 28rem;
    padding-block: var(--space-5);
  }
</style>
