---
import { HeroApp } from '../components/HeroApp';
import Header from '../components/site/Header.astro';
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
---

<Base title={t('common.app_title')} app hideHeader hideFooter noindex>
  <div class="first-screen">
    <Header variant="app" />
    <main id="conteudo" class="first-screen__hero" aria-label={t('landing.hero_region')}>
      <HeroApp client:load />
    </main>
  </div>
</Base>

<style>
  .first-screen__hero {
    min-height: 0;
  }
</style>
