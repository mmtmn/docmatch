---
import { HeroApp } from '../components/HeroApp';
import BlogLatest from '../components/site/BlogLatest.astro';
import Faq from '../components/site/Faq.astro';
import Header from '../components/site/Header.astro';
import HowItWorks from '../components/site/HowItWorks.astro';
import Plans from '../components/site/Plans.astro';
import Security from '../components/site/Security.astro';
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
---

<Base hideHeader skipTarget="#inicio">
  <div class="first-screen">
    <Header />
    <section
      id="inicio"
      class="first-screen__hero"
      aria-label={t('landing.hero_region')}
      tabindex="-1"
    >
      <HeroApp client:load />
    </section>
  </div>
  <main id="conteudo">
    <HowItWorks />
    <Plans />
    <Security />
    <BlogLatest />
    <Faq />
  </main>
</Base>

<style>
  .first-screen__hero {
    min-height: 0;
  }
</style>
