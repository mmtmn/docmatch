---
// Results of a run (/resultados?run=<id>) when the build knows the API; the demo screen behind
// PUBLIC_DM_FEATURE_RESULTS otherwise. Without either, no page is generated.
import { ResultsDemo } from '../../components/results/ResultsDemo';
import { ResultsLive } from '../../components/results/ResultsLive';
import Base from '../../layouts/Base.astro';
import Header from '../../components/site/Header.astro';
import { apiBaseUrl, featureResults } from '../../lib/env';
import { t } from '../../lib/i18n';

export function getStaticPaths() {
  return apiBaseUrl || featureResults ? [{ params: { rest: undefined } }] : [];
}
---

<Base title={t('results.title')} hideHeader noindex>
  <Header variant="app" />
  <main id="conteudo" class="container">
    {apiBaseUrl ? <ResultsLive client:only="react" /> : <ResultsDemo client:load />}
  </main>
</Base>
