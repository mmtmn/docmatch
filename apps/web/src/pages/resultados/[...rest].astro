---
// Results screen behind PUBLIC_DM_FEATURE_RESULTS: when the flag is off, no page is generated.
import { ResultsDemo } from '../../components/results/ResultsDemo';
import Base from '../../layouts/Base.astro';
import { featureResults } from '../../lib/env';
import { t } from '../../lib/i18n';

export function getStaticPaths() {
  return featureResults ? [{ params: { rest: undefined } }] : [];
}
---

<Base title={t('results.title')} noindex>
  <main id="conteudo" class="container">
    <ResultsDemo client:load />
  </main>
</Base>
