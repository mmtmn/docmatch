---
// Sign-in page: the API redirects OAuth errors here (?error=<code>); only exists with an API.
import { LoginPage } from '../components/account/LoginPage';
import Header from '../components/site/Header.astro';
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
---

<Base title={t('auth.login_title')} hideHeader noindex>
  <Header variant="app" />
  <main id="conteudo" class="container login">
    <LoginPage client:only="react" />
  </main>
</Base>

<style>
  .login {
    max-width: 28rem;
    padding-block: var(--space-5);
  }
</style>
