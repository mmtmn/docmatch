# apps/web — variáveis lidas no build (Astro). Copie para apps/web/.env se quiser sobrescrever
# localmente; o arquivo .env nunca é commitado. Nenhuma delas é segredo: tudo aqui vai para o HTML.

# Origem pública do site: canonical, sitemap, robots e security.txt (mesma variável da API).
DM_PUBLIC_BASE_URL=http://localhost:4321

# Origem da API (formulário de contato, orçamentos). Vazia = formulários desabilitados.
PUBLIC_DM_API_BASE_URL=

# Origens dos buckets que recebem os envios pré-assinados do navegador (CSP connect-src), separadas
# por espaço. Em produção vem do output uploads_origin do Terraform (infra/scripts/deploy-site.sh).
DM_UPLOAD_ORIGINS=

# Origem da mídia (Cloudflare R2) para os players de evidência; entra no CSP media-src.
PUBLIC_DM_MEDIA_BASE_URL=

# Liga a tela /resultados com dados de demonstração (e2e e revisão de UI). Nunca em produção.
PUBLIC_DM_FEATURE_RESULTS=false

# /.well-known/security.txt (RFC 9116). Contact é obrigatório em produção.
PUBLIC_DM_SECURITY_CONTACT=security@example.com
PUBLIC_DM_SECURITY_POLICY_URL=

# Links opcionais do rodapé (código-fonte, página de status).
PUBLIC_DM_SOURCE_URL=
PUBLIC_DM_STATUS_URL=
