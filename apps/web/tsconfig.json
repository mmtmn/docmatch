{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "noUncheckedSideEffectImports": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "vite/**/*",
    "test/**/*",
    "e2e/**/*",
    "astro.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "node_modules", "playwright-report", "test-results", ".vitest"]
}
