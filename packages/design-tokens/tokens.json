{
  "version": 1,
  "meta": {
    "name": "docmatch",
    "description": "Tokens de design compartilhados por web, Android e iOS. Fonte única: este arquivo gera tokens.css (build.mjs); nada é digitado à mão em outro lugar. Espaçamento em passos de 8 px, raio padrão 8 px, cores em claro e escuro com todos os pares texto/fundo nomeados abaixo verificados para WCAG AA (4,5:1).",
    "prefix": "dm"
  },
  "color": {
    "light": {
      "bg": {
        "canvas": "#FFFFFF",
        "surface": "#F4F6F8",
        "elevated": "#FFFFFF",
        "subtle": "#E9EDF1",
        "inverse": "#0F172A"
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#3F4A5A",
        "muted": "#5B6675",
        "inverse": "#F8FAFC",
        "link": "#1D4ED8"
      },
      "border": {
        "default": "#D5DBE3",
        "strong": "#9AA5B4",
        "focus": "#1D4ED8"
      },
      "brand": {
        "primary": "#1D4ED8",
        "primary_hover": "#1E40AF",
        "on_primary": "#FFFFFF",
        "subtle": "#DBEAFE",
        "on_subtle": "#1E3A8A"
      },
      "status": {
        "info": "#1D4ED8",
        "on_info": "#FFFFFF",
        "info_soft": "#DBEAFE",
        "on_info_soft": "#1E3A8A",
        "success": "#15803D",
        "on_success": "#FFFFFF",
        "success_soft": "#DCFCE7",
        "on_success_soft": "#14532D",
        "warning": "#B45309",
        "on_warning": "#FFFFFF",
        "warning_soft": "#FEF3C7",
        "on_warning_soft": "#78350F",
        "danger": "#B91C1C",
        "on_danger": "#FFFFFF",
        "danger_soft": "#FEE2E2",
        "on_danger_soft": "#7F1D1D"
      },
      "severity": {
        "info": "#1D4ED8",
        "on_info": "#FFFFFF",
        "low": "#0F766E",
        "on_low": "#FFFFFF",
        "medium": "#B45309",
        "on_medium": "#FFFFFF",
        "high": "#C2410C",
        "on_high": "#FFFFFF",
        "critical": "#B91C1C",
        "on_critical": "#FFFFFF"
      },
      "confidence": {
        "confirmed": "#15803D",
        "on_confirmed": "#FFFFFF",
        "probable": "#B45309",
        "on_probable": "#FFFFFF",
        "needs_you": "#6D28D9",
        "on_needs_you": "#FFFFFF"
      }
    },
    "dark": {
      "bg": {
        "canvas": "#0B1220",
        "surface": "#121A2B",
        "elevated": "#1A2437",
        "subtle": "#243049",
        "inverse": "#F8FAFC"
      },
      "text": {
        "primary": "#F1F5F9",
        "secondary": "#C3CCD9",
        "muted": "#97A3B4",
        "inverse": "#0F172A",
        "link": "#93C5FD"
      },
      "border": {
        "default": "#2C3850",
        "strong": "#4A5872",
        "focus": "#93C5FD"
      },
      "brand": {
        "primary": "#60A5FA",
        "primary_hover": "#93C5FD",
        "on_primary": "#0B1220",
        "subtle": "#1E3A8A",
        "on_subtle": "#DBEAFE"
      },
      "status": {
        "info": "#60A5FA",
        "on_info": "#0B1220",
        "info_soft": "#1E3A8A",
        "on_info_soft": "#DBEAFE",
        "success": "#4ADE80",
        "on_success": "#052E16",
        "success_soft": "#14532D",
        "on_success_soft": "#DCFCE7",
        "warning": "#FBBF24",
        "on_warning": "#451A03",
        "warning_soft": "#78350F",
        "on_warning_soft": "#FEF3C7",
        "danger": "#F87171",
        "on_danger": "#450A0A",
        "danger_soft": "#7F1D1D",
        "on_danger_soft": "#FEE2E2"
      },
      "severity": {
        "info": "#93C5FD",
        "on_info": "#0B1220",
        "low": "#5EEAD4",
        "on_low": "#0B1220",
        "medium": "#FCD34D",
        "on_medium": "#0B1220",
        "high": "#FDBA74",
        "on_high": "#0B1220",
        "critical": "#FCA5A5",
        "on_critical": "#0B1220"
      },
      "confidence": {
        "confirmed": "#4ADE80",
        "on_confirmed": "#0B1220",
        "probable": "#FCD34D",
        "on_probable": "#0B1220",
        "needs_you": "#C4B5FD",
        "on_needs_you": "#0B1220"
      }
    }
  },
  "typography": {
    "family": {
      "sans": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "scale": {
      "xs": { "size": 12, "line": 16 },
      "sm": { "size": 14, "line": 20 },
      "md": { "size": 16, "line": 24 },
      "lg": { "size": 18, "line": 28 },
      "xl": { "size": 20, "line": 28 },
      "2xl": { "size": 24, "line": 32 },
      "3xl": { "size": 30, "line": 36 },
      "4xl": { "size": 36, "line": 44 }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "letter_spacing": {
      "tight": "-0.01em",
      "normal": "0",
      "wide": "0.02em"
    }
  },
  "space": {
    "0": 0,
    "1": 8,
    "2": 16,
    "3": 24,
    "4": 32,
    "5": 40,
    "6": 48,
    "8": 64,
    "10": 80,
    "12": 96,
    "16": 128
  },
  "radius": {
    "none": 0,
    "sm": 4,
    "md": 8,
    "lg": 16,
    "full": 9999
  },
  "border_width": {
    "thin": 1,
    "thick": 2
  },
  "shadow": {
    "sm": "0 1px 2px rgb(15 23 42 / 0.06)",
    "md": "0 4px 12px rgb(15 23 42 / 0.10)",
    "lg": "0 12px 32px rgb(15 23 42 / 0.16)"
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 120,
      "base": 200,
      "slow": 320
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "z_index": {
    "dropdown": 100,
    "sticky": 200,
    "modal": 300,
    "toast": 400
  },
  "breakpoint": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280
  },
  "contrast_pairs": [
    { "text": "text.primary", "background": "bg.canvas" },
    { "text": "text.primary", "background": "bg.surface" },
    { "text": "text.primary", "background": "bg.elevated" },
    { "text": "text.primary", "background": "bg.subtle" },
    { "text": "text.secondary", "background": "bg.canvas" },
    { "text": "text.secondary", "background": "bg.surface" },
    { "text": "text.secondary", "background": "bg.elevated" },
    { "text": "text.secondary", "background": "bg.subtle" },
    { "text": "text.muted", "background": "bg.canvas" },
    { "text": "text.muted", "background": "bg.surface" },
    { "text": "text.muted", "background": "bg.elevated" },
    { "text": "text.muted", "background": "bg.subtle" },
    { "text": "text.link", "background": "bg.canvas" },
    { "text": "text.link", "background": "bg.surface" },
    { "text": "text.link", "background": "bg.elevated" },
    { "text": "text.link", "background": "bg.subtle" },
    { "text": "text.inverse", "background": "bg.inverse" },
    { "text": "brand.on_primary", "background": "brand.primary" },
    { "text": "brand.on_primary", "background": "brand.primary_hover" },
    { "text": "brand.on_subtle", "background": "brand.subtle" },
    { "text": "status.on_info", "background": "status.info" },
    { "text": "status.on_info_soft", "background": "status.info_soft" },
    { "text": "status.on_success", "background": "status.success" },
    { "text": "status.on_success_soft", "background": "status.success_soft" },
    { "text": "status.on_warning", "background": "status.warning" },
    { "text": "status.on_warning_soft", "background": "status.warning_soft" },
    { "text": "status.on_danger", "background": "status.danger" },
    { "text": "status.on_danger_soft", "background": "status.danger_soft" },
    { "text": "severity.info", "background": "bg.canvas" },
    { "text": "severity.info", "background": "bg.surface" },
    { "text": "severity.info", "background": "bg.elevated" },
    { "text": "severity.low", "background": "bg.canvas" },
    { "text": "severity.low", "background": "bg.surface" },
    { "text": "severity.low", "background": "bg.elevated" },
    { "text": "severity.medium", "background": "bg.canvas" },
    { "text": "severity.medium", "background": "bg.surface" },
    { "text": "severity.medium", "background": "bg.elevated" },
    { "text": "severity.high", "background": "bg.canvas" },
    { "text": "severity.high", "background": "bg.surface" },
    { "text": "severity.high", "background": "bg.elevated" },
    { "text": "severity.critical", "background": "bg.canvas" },
    { "text": "severity.critical", "background": "bg.surface" },
    { "text": "severity.critical", "background": "bg.elevated" },
    { "text": "severity.on_info", "background": "severity.info" },
    { "text": "severity.on_low", "background": "severity.low" },
    { "text": "severity.on_medium", "background": "severity.medium" },
    { "text": "severity.on_high", "background": "severity.high" },
    { "text": "severity.on_critical", "background": "severity.critical" },
    { "text": "confidence.confirmed", "background": "bg.canvas" },
    { "text": "confidence.confirmed", "background": "bg.surface" },
    { "text": "confidence.confirmed", "background": "bg.elevated" },
    { "text": "confidence.probable", "background": "bg.canvas" },
    { "text": "confidence.probable", "background": "bg.surface" },
    { "text": "confidence.probable", "background": "bg.elevated" },
    { "text": "confidence.needs_you", "background": "bg.canvas" },
    { "text": "confidence.needs_you", "background": "bg.surface" },
    { "text": "confidence.needs_you", "background": "bg.elevated" },
    { "text": "confidence.on_confirmed", "background": "confidence.confirmed" },
    { "text": "confidence.on_probable", "background": "confidence.probable" },
    { "text": "confidence.on_needs_you", "background": "confidence.needs_you" }
  ]
}
